# ─────────────────────────────────────────────────────────────────────────────
# Gomoku backend — образец переменных окружения.
#
# Как пользоваться:
#   1. скопируйте файл рядом:   Copy-Item .env.example .env
#   2. заполните значения (ниже только заглушки);
#   3. .env лежит в .gitignore и не коммитится — проверьте это до первого коммита.
#
# docker compose подхватывает .env автоматически и передаёт значения приложению
# (сопоставление с SPRING_* — в docker-compose.yml, см. TZ_BACKEND.md §13).
# Реальные секреты храните в менеджере паролей: USER_ACTION.md, §3.
# Значения из этого файла годятся только для локального стенда — на сервере они
# должны быть другими.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# База и пользователь создаются контейнером postgres при первом старте.
POSTGRES_DB=gomoku
POSTGRES_USER=gomoku
# 24–32 символа из A-Za-z0-9: символы @ : / # " ' $ и пробелы придётся
# экранировать в JDBC-URL и в compose.
POSTGRES_PASSWORD=change-me-24-32-alnum-chars
# Порт на localhost для psql/DBeaver. Наружу публиковать не нужно.
POSTGRES_HOST_PORT=5432

# ─── Приложение ──────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Сгенерировать:  openssl rand -base64 48
# Для HS256 нужно не меньше 32 байт; 48 — с запасом.
JWT_SECRET=change-me-48-bytes-base64
# Сроки жизни в формате ISO-8601: PT15M — 15 минут, P30D — 30 дней.
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# ─── Админка ─────────────────────────────────────────────────────────────────
# Ник аккаунта, которому при старте выдаётся роль администратора (панель /admin).
# Зарегистрируйте этот аккаунт в приложении, впишите ник и перезапустите сервер.
# Пусто — админки ни у кого нет. Подробности: USER_ACTION.md §12.
ADMIN_NICKNAME=

# ─── Юридические страницы ────────────────────────────────────────────────────
# Контактный адрес на /legal/privacy и /legal/delete-account. Нужен Google Play:
# это публичная точка связи для вопросов о данных и удалении аккаунта.
# Пока пусто, страницы ссылаются на карточку приложения в Play. См. PLAY_RELEASE.md.
LEGAL_CONTACT_EMAIL=

# ─── Прочее ──────────────────────────────────────────────────────────────────
# Контейнеры и БД работают в UTC, в клиент время отдаётся в ISO-8601.
TZ=UTC
# Память JVM: по умолчанию берётся 75 % лимита контейнера (`mem_limit` прод-стека).
# Явно ограничивать нужно только там, где Docker игнорирует `mem_limit` (Swarm):
# JAVA_OPTS=-Xmx512m
JAVA_OPTS=

# ─── Прод-стенд (docker-compose.prod.yml) ────────────────────────────────────
# Какой образ тянуть из GHCR (собирает GitHub Actions, .github/workflows/image.yml):
# latest — последняя сборка main; версия сервера (0.13.0) или тег с sha — для
# воспроизводимого деплоя и отката.
# IMAGE_TAG=latest

# Лимиты памяти контейнеров прод-стека; JVM берёт 75 % от APP_MEM_LIMIT.
# APP_MEM_LIMIT=1500m
# DB_MEM_LIMIT=512m

# ─── Запуск из IDE без Docker (раскомментируйте при необходимости) ───────────
# Приложение на хосте, база — в контейнере:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gomoku
# SPRING_DATASOURCE_USERNAME=gomoku
# SPRING_DATASOURCE_PASSWORD=<тот же пароль, что в POSTGRES_PASSWORD>